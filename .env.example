# Database driver: "pglite" (embedded, zero-setup dev default) or "postgres" (production)
DATABASE_DRIVER=pglite

# Only used when DATABASE_DRIVER=pglite. Folder where the embedded database file lives.
PGLITE_DATA_DIR=./.data/billgod-db

# Only used when DATABASE_DRIVER=postgres. A real hosted Postgres connection string.
# DATABASE_URL=postgres://user:password@host:5432/billgod

# Session cookie signing / naming
SESSION_COOKIE_NAME=billgod_session

# Email: "dev" writes to the in-app outbox instead of sending real mail.
EMAIL_PROVIDER=dev

# SMS: "dev" writes to the in-app outbox instead of sending real messages.
SMS_PROVIDER=dev

APP_URL=http://localhost:3000

# Testing phase only: skips the sign-in wall and auto-signs in a fixed local
# account so the app opens straight to the dashboard. Remove this (or set to
# anything but "true") once real accounts should gate access again.
# SKIP_AUTH=true
